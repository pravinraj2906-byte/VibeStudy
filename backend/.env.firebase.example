# =====================================================================
# DevMentor AI — Firebase Admin SDK Configuration (Backend)
# =====================================================================
# Follow the setup instructions in docs/FIREBASE_SETUP_GUIDE.md to obtain
# your service account key from the Firebase Console.
#
# Option A: Path to service account JSON file (Recommended)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option B: Raw JSON string (Useful in CI/CD or Cloud Deployments)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
