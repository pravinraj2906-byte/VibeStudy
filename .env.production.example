# DevMentor AI — Production Environment Configuration Template
# Copy this file to .env.production and populate real credentials.
# NEVER commit .env.production or secrets into version control!

# --- Application Environment ---
APP_ENV=production
DEBUG=false

# --- Database Configuration (Neon PostgreSQL) ---
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PRODUCTION_PASSWORD@ep-devmentor.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Security & JWT Cryptography ---
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_strong_random_32_byte_hex_secret_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI Intelligence (Google Gemini API) ---
# Retrieve from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...YOUR_SECURE_GEMINI_API_KEY

# --- CORS & Network Hygiene ---
# Comma-separated list of allowed origins (No wildcards permitted in production!)
CORS_ORIGINS=["https://YOUR-PROJECT.vercel.app"]
CODE_EXECUTION_ENABLED=false

# --- Container Isolation Limits (Production Defaults) ---
DOCKER_MAX_EXEC_SECONDS=45
DOCKER_MEMORY_LIMIT=512m
DOCKER_CPU_LIMIT=1.0
DOCKER_PIDS_LIMIT=64
